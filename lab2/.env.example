# Copy to .env and replace every value. .env is in .gitignore: secrets never go to Git.
POSTGRES_PASSWORD=change-me-postgres
AUTH_DB_PASSWORD=change-me-auth
USER_DB_PASSWORD=change-me-user
CATALOG_DB_PASSWORD=change-me-catalog
INVENTORY_DB_PASSWORD=change-me-inventory
CART_DB_PASSWORD=change-me-cart
ORDER_DB_PASSWORD=change-me-order
PAYMENT_DB_PASSWORD=change-me-payment
NOTIFICATION_DB_PASSWORD=change-me-notification
RABBITMQ_USER=shop
RABBITMQ_PASSWORD=change-me-rabbit
# at least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# accounts registered with these e-mails get the admin role (catalog, stock, orders)
ADMIN_EMAILS=admin@libraria.example
LOG_LEVEL=INFO
