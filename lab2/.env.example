# Copy to .env and replace every value. .env is in .gitignore: secrets never go to Git.
POSTGRES_PASSWORD=change-me-postgres
AUTH_DB_PASSWORD=change-me-auth
USER_DB_PASSWORD=change-me-user
HISTORY_DB_PASSWORD=change-me-history
NOTIFICATION_DB_PASSWORD=change-me-notification
RABBITMQ_USER=utm
RABBITMQ_PASSWORD=change-me-rabbit
# at least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-long-random-string
# accounts registered with these e-mails get the admin role (can start document collection)
ADMIN_EMAILS=admin@utm.example
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
LOG_LEVEL=INFO
