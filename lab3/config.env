# Non-secret settings for docker compose (the Kubernetes equivalent is k8s/configmaps/shop-config.yaml)
LOG_LEVEL=INFO
AUTH_URL=http://auth-service:8000
USER_URL=http://user-service:8000
CATALOG_URL=http://catalog-service:8000
INVENTORY_URL=http://inventory-service:8000
CART_URL=http://cart-service:8000
ORDER_URL=http://order-service:8000
PAYMENT_URL=http://payment-service:8000
NOTIFICATION_URL=http://notification-service:8000
ADMIN_EMAILS=admin@libraria.example
JWT_TTL_SECONDS=3600
SEED_CATALOG=true
PAYMENT_PROVIDER_DELAY_SECONDS=1.0
